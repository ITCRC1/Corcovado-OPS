# Datos y configuración: NUNCA deben subirse al repositorio.
# Contienen datos de huéspedes y secretos de la instalación.
data/
*.db
*.db-wal
*.db-shm
config_publicacion.json
config_qr.json
sync_config.json
config_opera.json
# Credenciales de Opera Cloud y llaves de los avisos al celular. Viven en data/ (que ya
# esta excluida), pero se nombran aparte a proposito: son secretos, y si algun dia
# alguien los deja por error en la raiz del proyecto, esta linea los sigue excluyendo.
credenciales_opera.json
llaves_avisos.json
cache_itinerarios/
# Respuestas crudas de Opera Cloud guardadas por "opera_cloud.py descubrir":
# traen nombres y datos de huéspedes tal como los devuelve Oracle.
opera_muestras/
# Los bloques de datos que la propiedad concede, aprendidos en la primera consulta.
# No es un secreto, pero es del servidor donde corre: cada instalación aprende los
# suyos y traerlos de otra haría pedir bloques que aquí no existen.
opera_bloques.json

# Reportes del PMS y hojas de cálculo. Traen nombres, fechas y datos personales
# de los huéspedes. Si uno de estos archivos se deja en la carpeta del proyecto,
# sin esta regla se subiría a GitHub junto con el código.
# (El repositorio no usa PDF ni Excel para nada propio, así que excluirlos todos
# es seguro. Si algún día hace falta versionar uno, se agrega con "git add -f".)
*.pdf
*.xlsx
*.xls
*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
.env
.env.*

data-avisos/
